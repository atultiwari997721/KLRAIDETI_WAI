      "permanent": false
    },
    {
      "source": "/download/latest",
      "destination": "https://github.com/atultiwari997721/KLRAIDETI_WAI/releases/download/v1.0.0/KritiAi-desktop-win-x64.exe",
      "permanent": false
    },
    {
